{#
field         FormView  unmapped text field, value = comma separated tag names
allow_create  bool      show button for creating a new tag
#}
{% macro tags(field, allow_create = false) %}
    {% set input_id = field.vars.id %}
    {% set modal_id = input_id ~ '_create_modal' %}
    {% set name_input_id = input_id ~ '_create_name' %}
    <div class="col-12">
        <div class="d-flex align-items-start gap-2">
            <div class="w-100">
                {{ form_widget(field, {attr: {class: 'form-control form-control-solid'}}) }}
            </div>
            {% if allow_create %}
                <button type="button"
                        class="btn btn-light-primary btn-icon flex-shrink-0"
                        data-bs-toggle="modal"
                        data-bs-target="#{{ modal_id }}"
                        title="Nový štítek">
                    <i class="bi bi-plus-lg"></i>
                </button>
            {% endif %}
        </div>
    </div>

    {% if allow_create %}
        <div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Nový štítek</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                    </div>
                    <div class="modal-body">
                        <label for="{{ name_input_id }}" class="form-label">Název štítku</label>
                        <input type="text"
                               class="form-control form-control-solid"
                               id="{{ name_input_id }}"
                               maxlength="100"/>
                        <div class="text-danger mt-2 d-none" id="{{ name_input_id }}_error"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Zrušit</button>
                        <button type="button" class="btn btn-primary" id="{{ name_input_id }}_save">Uložit a přidat
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# plugins.bundle.js contains only tagify polyfills, styles are in plugins.bundle.css #}
    <script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify@4.27.0/dist/tagify.min.js"></script>
    <!--suppress JSUnresolvedReference -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.querySelector('#{{ input_id }}');
            let controller;

            const tagify = new Tagify(input, {
                enforceWhitelist: true,
                whitelist: input.value ? input.value.split(',') : [],
                maxTags: 10,
                dropdown: {
                    maxItems: 20,
                    classname: 'tagify__inline__suggestions',
                    enabled: 0,
                    closeOnSelect: false
                },
                // submit plain comma separated names instead of JSON
                originalInputValueFormat: function (values) {
                    return values.map(function (item) {
                        return item.value;
                    }).join(',');
                }
            });

            function loadSuggestions(q) {
                controller && controller.abort();
                controller = new AbortController();

                tagify.whitelist = null;
                tagify.loading(true).dropdown.hide();

                fetch('{{ path('admin:api:web:tag:suggestions') }}?q=' + encodeURIComponent(q), {signal: controller.signal})
                    .then(function (r) {
                        return r.json();
                    })
                    .then(function (names) {
                        tagify.whitelist = names;
                        tagify.loading(false).dropdown.show(q);
                    })
                    .catch(function (err) {
                        if (err.name !== 'AbortError') {
                            tagify.loading(false);
                        }
                    });
            }

            tagify.on('input', function (e) {
                loadSuggestions(e.detail.value);
            });
            tagify.on('focus', function () {
                loadSuggestions('');
            });

            {% if allow_create %}
            (function () {
                const modalEl = document.querySelector('#{{ modal_id }}');
                const nameInput = document.querySelector('#{{ name_input_id }}');
                const saveBtn = document.querySelector('#{{ name_input_id }}_save');
                const errorEl = document.querySelector('#{{ name_input_id }}_error');
                if (!modalEl || !nameInput || !saveBtn) {
                    return;
                }
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                modalEl.addEventListener('shown.bs.modal', function () {
                    nameInput.value = '';
                    errorEl.classList.add('d-none');
                    nameInput.focus();
                });

                function submit() {
                    const name = nameInput.value.trim();
                    if (name === '') {
                        return;
                    }

                    saveBtn.disabled = true;
                    errorEl.classList.add('d-none');

                    fetch('{{ path('admin:api:web:tag:create') }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({name: name})
                    })
                        .then(function (r) {
                            return r.json();
                        })
                        .then(function (res) {
                            if (!res || res.status !== 'success') {
                                throw new Error('fail');
                            }
                            const tagName = res.data.name;
                            tagify.whitelist = (tagify.whitelist || []).concat([tagName]);
                            tagify.addTags([tagName]);
                            modal.hide();
                        })
                        .catch(function () {
                            errorEl.textContent = 'Štítek se nepodařilo uložit.';
                            errorEl.classList.remove('d-none');
                        })
                        .finally(function () {
                            saveBtn.disabled = false;
                        });
                }

                saveBtn.addEventListener('click', submit);
                nameInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        submit();
                    }
                });
            })();
            {% endif %}
        });
    </script>
{% endmacro %}
