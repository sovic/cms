{% extends '@CmsBundle/admin/layout/admin.html.twig' %}

{% form_theme form '@CmsBundle/admin/forms/form-narrow.html.twig' %}

{% import '@CmsBundle/admin/macros/form.html.twig' as form_macro %}
{% import '@CmsBundle/admin/macros/theme.html.twig' as theme %}

{% block content %}
    <div class="app-container container-xxl">
        <div class="d-flex flex-column flex-xl-row">
            {{ block('sidebar') }}

            <div class="flex-lg-row-fluid ms-lg-10">
                {{ block('edit_card') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block sidebar %}
    <div class="flex-column flex-lg-row-auto w-100 w-xl-300px mb-10">
        <div class="{{ theme.card_class() }}">
            <div class="{{ theme.card_body_class() }}">
                <div class="d-flex flex-column mb-2">
                    <span class="fw-bold fs-3 text-gray-800">Nastavení</span>
                </div>

                <div class="js-toggle-switch d-flex flex-column gap-3 mt-4"
                     data-url="{{ path('admin:api:web:ai:settings:toggle-state') }}">
                    {{ form_macro.check_button('ai_setting_is_enabled', 'is_enabled', 'AI asistent', is_enabled, 'bi bi-stars', false, ['AI asistent je zapnutý', 'AI asistent je vypnutý, na stránkách se nezobrazí'], 'w-100') }}
                    {% if has_api_key %}
                        {{ form_macro.check_button('ai_setting_has_api_key', 'has_api_key', 'API klíč', true, 'bi bi-key', false, ['API klíč je nastaven, kliknutím jej odstraníte', 'API klíč není nastaven'], 'w-100', {'data-confirm': 'Opravdu odstranit uložený API klíč?', 'data-reload': ''}) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block edit_card %}
    <div class="{{ theme.card_class() }}">
        {{ form_macro.card_header('AI asistent', '') }}

        <div class="card-body">
            <div class="alert {{ has_api_key ? 'alert-success' : 'alert-warning' }} d-flex align-items-center mb-8">
                <i class="bi {{ has_api_key ? 'bi-key' : 'bi-exclamation-triangle' }} {{ has_api_key ? 'text-success' : 'text-warning' }} fs-2 me-4"></i>
                <div>
                    {% if has_api_key %}
                        <span class="fs-6">API klíč je nastaven (končí na <strong>…{{ key_hint }}</strong>).</span>
                    {% else %}
                        <span class="fs-6">API klíč není nastaven, AI asistent na stránkách nebude fungovat.</span>
                    {% endif %}
                    <div class="mt-1">
                        Asistent používá váš vlastní klíč k Anthropic API, spotřeba se účtuje na váš účet.
                        <br>
                        Klíč vytvoříte na
                        <a href="https://console.anthropic.com/settings/keys"
                           class="{{ has_api_key ? 'text-success' : 'text-warning' }} fw-bold" target="_blank"
                           rel="noopener">console.anthropic.com</a>.
                        Výchozí model: <code>{{ default_model }}</code>.
                    </div>
                </div>
            </div>

            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.api_key) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.model) }}
                </div>
            </div>
            <div class="{{ theme.form_sticky_bar_class() }}">
                {{ form_row(form.save) }}
            </div>
            <div class="mt-n5"></div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('bundles/cms/js/toggle-switch.js') }}"></script>
{% endblock %}
