{% extends '@CmsBundle/admin/layout/data-list.html.twig' %}

{% import '@CmsBundle/admin/macros/data-list.html.twig' as data_list %}
{% import '@CmsBundle/admin/macros/theme.html.twig' as theme %}

{% block title %}Přehled šablon emailů{% endblock %}

{% set allow_add = true %}
{% set is_search_enabled = false %}
{% set is_filters_enabled = false %}
{% set is_group_actions_enabled = false %}
{% set is_all_allowed = true %}

{% if is_admin is not defined %}
    {% set is_admin = false %}
{% endif %}

{% block data_list_title %}
    <h2>Šablony emailů</h2>
{% endblock %}

{% block add_item %}
    {% if allow_add %}
        {{ data_list.add_button('Nová šablona', 'admin:email:edit') }}
    {% endif %}
{% endblock %}

{% block data_list_table %}
    <table class="{{ theme.table_class() }}">
        <thead>
        <tr class="{{ theme.thead_tr_class() }}" role="row">
            {% if is_group_actions_enabled %}
                {{ data_list.checkbox_all() }}
            {% endif %}
            <th class="min-w-100px" data-dt-column="1">
                <span class="dt-column-title">Vytvořen</span>
            </th>
            <th class="min-w-350px" data-dt-column="2">
                <span class="dt-column-title">Název</span>
            </th>
            {% if is_admin %}
                <th class="d-md-none d-xl-table-cell min-w-100px" data-dt-column="3">
                    <span class="dt-column-title">Vytvořil</span>
                </th>
            {% endif %}
            <th class="text-end min-w-70px" data-dt-column="4" aria-label="Akce"></th>
        </tr>
        </thead>
        <tbody class="{{ theme.tbody_class() }}">
        {% for item in emails %}
            {% set detail_url = path('admin:email:edit', {'id': item.id}) %}
            <tr>
                {% if is_group_actions_enabled %}
                    <td>
                        {{ data_list.checkbox(item.id) }}
                    </td>
                {% endif %}
                <td>
                    <span class="fw-bold">{{ item.createdAt|date('j.n.Y')|raw }}</span>
                </td>
                <td>
                    <a href="{{ detail_url }}"
                       class="text-gray-800 text-hover-primary fs-5 fw-bold">
                        {{ item.name }}
                    </a>
                    {% if item.emailId %}
                        <br>
                        <span class="badge badge-light-info me-2">Systémový email</span>
                        <span class="badge badge-light font-monospace">{{ item.emailId }}</span>
                    {% endif %}
                </td>
                {% if is_admin %}
                    <td>
                        {% set user = item.creator %}
                        {% if user %}
                            <a href="{{ path('user_edit', {'id': user.id}) }}"
                               class="fs-6">
                                {{ user.displayName ? user.displayName : user.email }}
                            </a>
                        {% endif %}
                    </td>
                {% endif %}
                <td class="text-end">
                    <a href="#"
                       class="btn btn-icon btn-active-light-primary w-30px h-30px"
                       data-bs-toggle="modal"
                       data-bs-target="#email-preview-modal"
                       data-preview-url="{{ path('admin:email:preview', {'id': item.id}) }}"
                       data-preview-title="{{ item.name }}"
                       data-preview-subject="{{ item.subject }}"
                       data-preview-edit-url="{{ detail_url }}"
                       title="Náhled"
                       aria-label="Náhled">
                        <i class="ki-duotone ki-eye fs-3">
                            <span class="path1"></span>
                            <span class="path2"></span>
                            <span class="path3"></span>
                        </i>
                    </a>
                    {% set actions = [] %}
                    {% if is_admin and not item.emailId %}
                        {% set actions = actions|merge([
                            {
                                'url': '#',
                                'title': 'Archivovat',
                                'method': 'email/' ~ item.id ~ '/delete',
                                'class': 'text-warning'
                            }
                        ]) %}
                    {% endif %}
                    {{ data_list.actions(actions) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot></tfoot>
    </table>

    <div class="modal fade" id="email-preview-modal" tabindex="-1" aria-labelledby="email-preview-title"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="min-w-0">
                        <h5 class="modal-title text-truncate" id="email-preview-title"></h5>
                        <div class="text-muted fs-7 text-truncate">
                            Předmět: <span id="email-preview-subject"></span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                </div>
                <div class="modal-body p-0">
                    {# sandbox without allow-scripts / allow-same-origin, the preview cannot touch the admin #}
                    <iframe id="email-preview-frame"
                            title="Náhled emailu"
                            sandbox="allow-popups allow-popups-to-escape-sandbox"
                            src="about:blank"
                            class="d-block w-100 border-0"
                            style="height: 70vh;"></iframe>
                </div>
                <div class="modal-footer">
                    <span class="text-muted fs-7 me-auto">Proměnné jsou zobrazeny jako <code>{název}</code>.</span>
                    <a href="#" class="btn btn-primary" id="email-preview-edit">Upravit</a>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Zavřít</button>
                </div>
            </div>
        </div>
    </div>

    <!--suppress JSUnresolvedReference -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const $modal = document.getElementById('email-preview-modal');
            if (!$modal) {
                return;
            }
            const $frame = document.getElementById('email-preview-frame');

            $modal.addEventListener('show.bs.modal', function (event) {
                const $button = event.relatedTarget;
                if (!$button) {
                    return;
                }
                document.getElementById('email-preview-title').textContent = $button.dataset.previewTitle || '';
                document.getElementById('email-preview-subject').textContent = $button.dataset.previewSubject || '-';
                document.getElementById('email-preview-edit').href = $button.dataset.previewEditUrl || '#';
                $frame.src = $button.dataset.previewUrl;
            });
            $modal.addEventListener('hidden.bs.modal', function () {
                $frame.src = 'about:blank';
            });
        });
    </script>
{% endblock %}
