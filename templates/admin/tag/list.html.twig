{% extends '@CmsBundle/admin/layout/data-list.html.twig' %}

{% import '@CmsBundle/admin/macros/data-list.html.twig' as data_list %}
{% import '@CmsBundle/admin/macros/form.html.twig' as form_macro %}
{% import '@CmsBundle/admin/macros/icons.html.twig' as icons %}
{% import '@CmsBundle/admin/macros/theme.html.twig' as theme %}

{% block title %}Přehled štítků{% endblock %}

{% set allow_add = true %}
{% set is_search_enabled = true %}
{% set is_filters_enabled = view == 'tags' %}
{% set is_group_actions_enabled = view == 'tags' %}
{# group column is redundant when listing a single group #}
{% set show_group_column = view == 'tags' and (group_id ?? null) is null %}

{% block data_list_title %}
    {% if view == 'tags' %}
        <h2 class="mb-5">
            <a class="text-gray-500 text-hover-primary me-2" href="{{ path('admin:tag:list') }}">Štítky</a>
            <span class="text-gray-400 me-2">/</span>
            {% if current_group %}
                {{ current_group.name }}
                <a href="{{ path('admin:tag-group:edit', {'id': current_group.id}) }}"
                   class="text-muted text-hover-primary ms-2 fs-5"
                   title="Upravit skupinu">
                    <i class="ki-duotone ki-pencil fs-4"><span class="path1"></span><span class="path2"></span></i>
                </a>
            {% elseif group_id is same as(0) %}
                Bez skupiny
            {% else %}
                Všechny štítky
            {% endif %}
        </h2>
    {% else %}
        <h2 class="mb-5">Štítky</h2>
    {% endif %}
{% endblock %}

{% block add_item %}
    {% if view == 'groups' %}
        {{ data_list.add_button('Nová skupina', 'admin:tag-group:edit') }}
    {% endif %}
    {% if allow_add %}
        {{ data_list.add_button('Nový štítek', 'admin:tag:edit', current_group is defined and current_group ? {'group_id': current_group.id} : {}) }}
    {% endif %}
{% endblock %}

{% block filters %}
    {% if view == 'tags' %}
        {{ data_list.list_filter_id_name_select('Skupina', 'group_id', [{id: 0, name: 'Bez skupiny'}]|merge(groups), group_id ?? '') }}
    {% endif %}
{% endblock %}

{% block data_list_group_actions %}
    {% if is_group_actions_enabled and tags|length > 0 %}
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="text-muted fs-7 me-1">Vybrané:</span>
            {% if groups|length > 0 %}
                <a href="#"
                   class="badge badge-light-primary"
                   data-kt-menu-trigger="click"
                   data-kt-menu-placement="bottom-start">
                    Přesunout do skupiny <i class="bi bi-chevron-down fs-8 ms-1 text-primary"></i>
                </a>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-225px py-3"
                     data-kt-menu="true">
                    {% for group in groups %}
                        <div class="menu-item px-3">
                            <a href="#"
                               class="menu-link px-3 group-action"
                               data-method="tag/set-group"
                               data-parameters="{{ {'group_id': group.id}|json_encode }}">
                                {{ group.name }}
                            </a>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            {{ data_list.group_action_button('tag/set-group', 'Odebrat ze skupiny', '', true, {'group_id': null}) }}
        </div>
    {% endif %}
{% endblock %}

{% block data_list_table %}
    {% if view == 'groups' %}
        {{ block('groups_table') }}
    {% else %}
        {{ block('tags_table') }}
    {% endif %}
{% endblock %}

{% block groups_table %}
    <table class="{{ theme.table_class() }}">
        <thead>
        <tr class="{{ theme.thead_tr_class() }}" role="row">
            <th class="min-w-350px">
                <span class="dt-column-title">Skupina</span>
            </th>
            <th class="text-end min-w-100px">
                <span class="dt-column-title">Štítků</span>
            </th>
            <th class="text-end min-w-150px" aria-label="Akce">
                <span class="dt-column-title">Akce</span>
            </th>
        </tr>
        </thead>
        <tbody class="{{ theme.tbody_class() }}">
        {% for group in groups %}
            {% set group_url = path('admin:tag:list', {'group_id': group.id}) %}
            {% set count = group_counts[group.id] ?? 0 %}
            {% set preview = group_previews[group.id] ?? [] %}
            <tr>
                <td>
                    <div class="d-flex align-items-start gap-4 py-2">
                        {{ icons.icon_symbol_50px('bi bi-tags') }}
                        <div>
                            <a href="{{ group_url }}"
                               class="text-gray-800 text-hover-primary fs-5 fw-bold">
                                {{ group.name }}
                            </a>
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                {% for tag in preview %}
                                    <a href="{{ path('admin:tag:edit', {'id': tag.id}) }}"
                                       class="badge {{ tag.isPublic ? 'badge-light-primary' : 'badge-light' }}">
                                        {{ tag.name }}
                                    </a>
                                {% else %}
                                    <span class="text-muted fs-7">Skupina zatím neobsahuje žádné štítky.</span>
                                {% endfor %}
                                {% if count > preview|length %}
                                    <a href="{{ group_url }}" class="badge badge-light-info">
                                        + {{ count - preview|length }} dalších
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </td>
                <td class="text-end fw-semibold">
                    {{ count }}
                </td>
                <td class="text-end">
                    {% set actions = [
                        {
                            'url': group_url,
                            'title': 'Zobrazit štítky',
                            'icon': 'ki-duotone ki-eye',
                        },
                        {
                            'url': path('admin:tag-group:edit', {'id': group.id}),
                            'title': 'Upravit',
                            'class': 'text-primary',
                            'icon': 'ki-duotone ki-pencil',
                        },
                        {
                            'url': '#',
                            'title': 'Smazat',
                            'method': 'tag-group/' ~ group.id ~ '/delete',
                            'confirm': 'Opravdu chcete smazat tuto skupinu? Štítky zůstanou zachovány bez skupiny.',
                            'btn_class': 'btn-active-light-danger action-button',
                            'icon': 'ki-duotone ki-trash',
                        },
                    ] %}
                    {{ data_list.actions_icons(actions) }}
                </td>
            </tr>
        {% endfor %}
        <tr>
            <td>
                <div class="d-flex align-items-center gap-4 py-2">
                    {{ icons.icon_symbol_50px('bi bi-tag', 'warning') }}
                    <a href="{{ path('admin:tag:list', {'group_id': 0}) }}"
                       class="text-gray-600 text-hover-primary fs-5 fw-semibold">
                        Bez skupiny
                    </a>
                </div>
            </td>
            <td class="text-end text-muted">{{ ungrouped_count }}</td>
            <td></td>
        </tr>
        <tr>
            <td>
                <div class="d-flex align-items-center gap-4 py-2">
                    {{ icons.icon_symbol_50px('bi bi-collection', 'info') }}
                    <a href="{{ path('admin:tag:list', {'view': 'tags'}) }}"
                       class="text-gray-600 text-hover-primary fs-5 fw-semibold">
                        Všechny štítky
                    </a>
                </div>
            </td>
            <td class="text-end text-muted">{{ total_count }}</td>
            <td></td>
        </tr>
        </tbody>
        <tfoot></tfoot>
    </table>
{% endblock %}

{% block tags_table %}
    {% set columns = 5 + (show_group_column ? 1 : 0) %}
    <table class="{{ theme.table_class() }}">
        <thead>
        <tr class="{{ theme.thead_tr_class() }}" role="row">
            {{ data_list.checkbox_all() }}
            <th class="min-w-250px">
                <span class="dt-column-title">Štítek</span>
            </th>
            {% if show_group_column %}
                <th class="min-w-150px">
                    <span class="dt-column-title">Skupina</span>
                </th>
            {% endif %}
            <th class="text-end min-w-125px">
                <span class="dt-column-title">Použití</span>
            </th>
            <th class="min-w-125px">
                <span class="dt-column-title">Publikováno</span>
            </th>
            <th class="text-end min-w-100px" aria-label="Akce">
                <span class="dt-column-title">Akce</span>
            </th>
        </tr>
        </thead>
        <tbody class="{{ theme.tbody_class() }}">
        {% for tag in tags %}
            {% set detail_url = path('admin:tag:edit', {'id': tag.id}) %}
            {% set tag_usage = usage[tag.id] ?? {'posts': 0, 'pages': 0} %}
            <tr>
                <td>
                    {{ data_list.checkbox(tag.id) }}
                </td>
                <td class="align-middle">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-hash fs-3 {{ tag.isPublic ? 'text-primary' : 'text-gray-400' }}"></i>
                        <div>
                            <a href="{{ detail_url }}"
                               class="text-gray-800 text-hover-primary fs-5 fw-bold">
                                {{ tag.name }}
                            </a>
                            {% if tag.private %}
                                <span class="badge badge-light-warning ms-2">Soukromý</span>
                            {% endif %}
                        </div>
                    </div>
                </td>
                {% if show_group_column %}
                    <td class="align-middle">
                        {% if tag.tagGroup %}
                            <a href="{{ path('admin:tag:list', {'group_id': tag.tagGroup.id}) }}"
                               class="badge badge-light-primary">
                                <i class="bi bi-tags text-primary me-1 fs-8"></i>{{ tag.tagGroup.name }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                {% endif %}
                <td class="text-end align-middle">
                    {% if tag_usage.posts == 0 and tag_usage.pages == 0 %}
                        <span class="badge rounded-pill badge-light text-muted">nepoužitý</span>
                    {% else %}
                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                            {% if tag_usage.posts > 0 %}
                                <span class="badge rounded-pill badge-light-success" title="Příspěvky">
                                    <i class="bi bi-file-text text-success me-1"></i>{{ tag_usage.posts }}
                                </span>
                            {% endif %}
                            {% if tag_usage.pages > 0 %}
                                <span class="badge rounded-pill badge-light-info" title="Stránky">
                                    <i class="bi bi-file-earmark text-info me-1"></i>{{ tag_usage.pages }}
                                </span>
                            {% endif %}
                        </div>
                    {% endif %}
                </td>
                <td class="align-middle">
                    <div class="{{ theme.toggle_switch_class() }}"
                         data-entity="tag"
                         data-entity-id="{{ tag.id }}">
                        {{ form_macro.switch('tag_is_public_' ~ tag.id, 'is_public', 'Publikováno', tag.isPublic, 'bi bi-check-circle-fill') }}
                    </div>
                </td>
                <td class="text-end">
                    {% set actions = [
                        {
                            'url': detail_url,
                            'title': 'Upravit',
                            'class': 'text-primary',
                            'icon': 'ki-duotone ki-pencil',
                        },
                        {
                            'url': '#',
                            'title': 'Smazat',
                            'method': 'tag/' ~ tag.id ~ '/delete',
                            'confirm': 'Opravdu chcete smazat tento štítek? Bude odebrán ze všech příspěvků a stránek.',
                            'btn_class': 'btn-active-light-danger action-button',
                            'icon': 'ki-duotone ki-trash',
                        }
                    ] %}
                    {{ data_list.actions_icons(actions) }}
                </td>
            </tr>
        {% else %}
            {{ data_list.no_items_row(columns, 'Žádné štítky') }}
        {% endfor %}
        </tbody>
        <tfoot></tfoot>
    </table>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/cms/js/toggle-switch.js') }}"></script>
{% endblock %}
