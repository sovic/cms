{% extends '@CmsBundle/admin/layout/admin.html.twig' %}
{% form_theme form '@CmsBundle/admin/forms/form-narrow.html.twig' %}
{% import '@CmsBundle/admin/macros/content-editor.html.twig' as content_editor %}
{% import '@CmsBundle/admin/macros/form.html.twig' as form_macro %}
{% import '@CmsBundle/admin/macros/gallery.html.twig' as gallery_macro %}
{% import '@CmsBundle/admin/macros/tags.html.twig' as tags %}
{% import '@CmsBundle/admin/macros/theme.html.twig' as theme %}

{% block content %}
    <div class="app-container container-xxl">
        <div class="d-flex flex-column flex-xl-row">
            {% if editing %}
                {{ block('sidebar') }}
            {% endif %}

            <div class="flex-lg-row-fluid {{ editing ? 'ms-lg-10' : '' }}">
                {% if editing %}
                    {{ block('tabs') }}

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tab-form" role="tabpanel">
                            {{ block('edit_card') }}
                        </div>
                        {{ gallery_macro.gallery_tabs_panes('post', post.id, galleries, true) }}
                    </div>
                {% else %}
                    {{ block('edit_card') }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block sidebar %}
    <div class="flex-column flex-lg-row-auto w-100 w-xl-300px mb-10">
        <div class="{{ theme.card_class() }}">
            <div class="{{ theme.card_body_class() }}">
                <div class="d-flex flex-column mb-2">
                    <span class="fw-bold fs-3 text-gray-800">Nastavení</span>
                </div>

                <div class="js-toggle-switch d-flex flex-column gap-3 mt-4"
                     data-entity="post"
                     data-entity-id="{{ post.id }}">
                    {{ form_macro.check_button('post_is_public_' ~ post.id, 'is_public', 'Publikováno', post.isPublic, 'bi bi-globe', false, ['Příspěvek je zveřejněn, na webu se zobrazí od data publikování', 'Příspěvek není zveřejněn, na webu se nezobrazí'], 'w-100') }}
                    {{ form_macro.check_button('post_is_private_' ~ post.id, 'is_private', 'Soukromý', post.isPrivate, 'bi bi-key', false, ['Příspěvek je soukromý, po publikování se zobrazí jen přímým odkazem', 'Příspěvek není soukromý, po publikování se zobrazí všem'], 'w-100 check-button-muted') }}
                </div>

                <div class="separator my-5"></div>
                {% if post.publishDate is not null and post.publishDate > date() %}
                    <div class="d-flex justify-content-between fs-7 mb-2">
                        <span class="text-muted">Naplánováno na</span>
                        <span class="text-gray-800">{{ post.publishDate|format_date_time }}</span>
                    </div>
                {% else %}
                    <div class="d-flex justify-content-between fs-7">
                        <span class="text-muted">Publikování</span>
                        <span class="text-gray-800">{{ post.publishDate ? post.publishDate|format_date_time : '-' }}</span>
                    </div>
                {% endif %}

                <div class="d-flex justify-content-between fs-7">
                    <span class="text-muted">Vytvoření</span>
                    <span class="text-gray-800">{{ post.createDate|format_date_time }}</span>
                </div>
            </div>
        </div>

        {% if post_public_url %}
            <div class="{{ theme.card_class() }}">
                <div class="card-body pt-8 d-flex flex-column gap-3">
                    {{ form_macro.section_header('Odkazy') }}

                    <a class="btn btn-flex btn-sm btn-light-primary w-100"
                       href="{{ post_public_url }}" target="_blank">
                        <i class="bi bi-globe me-1"></i>
                        Příspěvek na webu
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block tabs %}
    <ul class="{{ theme.nav_tabs_class() }}" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="tab-form-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-form"
                    type="button"
                    role="tab"
                    aria-selected="true">
                Příspěvek
            </button>
        </li>
        {{ gallery_macro.gallery_tabs_nav(galleries, 'post') }}
    </ul>
{% endblock %}

{% block edit_card %}
    <div class="{{ theme.card_class() }}">
        {{ form_macro.card_header('Editace příspěvku') }}

        <div class="card-body">
            {{ block('edit_form') }}
        </div>
    </div>
{% endblock %}

{% block edit_form %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_macro.section_header('Základní informace') }}
    <div class="row mb-4">
        <div class="col-12">
            {{ form_row(form.name) }}
        </div>
        <div class="col-6">
            {{ form_row(form.subtitle) }}
        </div>
        <div class="col-6">
            {{ form_row(form.publishDate) }}
        </div>
    </div>

    {{ form_macro.section_header('Obsah příspěvku') }}
    <div class="row mb-4">
        <div class="col-12">
            {{ form_row(form.content) }}
        </div>
        <div class="col-12">
            {{ form_row(form.perex) }}
        </div>
    </div>

    {% if form.tags is defined %}
        {{ form_macro.section_header('Štítky') }}
        <div class="row mb-4">
            <div class="mb-2">
                {{ tags.tags(form.tags, true) }}
            </div>
        </div>
    {% endif %}

    {# keep metadata open when its fields have errors #}
    {% set metadata_open = form.urlId.vars.errors|length > 0
        or form.metaTitle.vars.errors|length > 0
        or form.metaDescription.vars.errors|length > 0
        or form.metaKeywords.vars.errors|length > 0 %}
    <div class="row" id="post-metadata-header" style="scroll-margin-top: 100px;">
        <div class="col-12">
            <h3 class="mb-4">
                <a class="togglable-form-section text-gray-900 text-hover-primary {{ metadata_open ? '' : 'collapsed' }} d-inline-flex align-items-center gap-2"
                   data-bs-toggle="collapse"
                   href="#post-metadata"
                   role="button"
                   aria-expanded="{{ metadata_open ? 'true' : 'false' }}"
                   aria-controls="post-metadata">
                    Metadata
                    <i class="bi bi-chevron-right fs-5"></i>
                </a>
            </h3>
        </div>
    </div>
    <div class="row collapse {{ metadata_open ? 'show' : '' }}" id="post-metadata">
        <div class="col-6">
            {{ form_row(form.urlId) }}
        </div>
        <div class="col-6">
            {{ form_row(form.metaTitle) }}
        </div>
        <div class="col-12">
            {{ form_row(form.metaDescription) }}
        </div>
        <div class="col-12">
            {{ form_row(form.metaKeywords) }}
        </div>
    </div>

    <div class="position-sticky bottom-0 mt-2 py-5 bg-body border-top"
         id="page-sticky-bar"
         data-hide-except-tab="tab-form">
        {% if form._token is defined %}
            {{ form_row(form._token) }}
        {% endif %}
        {% if form.save is defined %}
            {{ form_row(form.save) }}
        {% endif %}
    </div>
    <div class="mt-n5"></div>

    {{ form_end(form, {render_rest: true}) }}

    {{ content_editor.content_editor_basic('#post_content', 'cs', null, tinymce_content_css) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('bundles/cms/js/tabs.js') }}"></script>
    <script src="{{ asset('bundles/cms/js/toggle-switch.js') }}"></script>
    <script>
        document.getElementById('post-metadata')?.addEventListener('shown.bs.collapse', () => {
            document.getElementById('post-metadata-header').scrollIntoView({behavior: 'smooth', block: 'start'});
        });
    </script>
    {% include '@CmsBundle/admin/partials/gallery-scripts.html.twig' %}
{% endblock %}
