{% extends '@CmsBundle/admin/layout/admin.html.twig' %}
{% form_theme form '@CmsBundle/admin/forms/form-narrow.html.twig' %}
{% import '@CmsBundle/admin/macros/data-list.html.twig' as data_list %}
{% import '@CmsBundle/admin/macros/form.html.twig' as form_macro %}
{% import '@CmsBundle/admin/macros/icons.html.twig' as icons %}
{% import '@CmsBundle/admin/macros/tag-color.html.twig' as tag_color %}
{% import '@CmsBundle/admin/macros/theme.html.twig' as theme %}

{% block title %}
    {{ editing ? 'Editace skupiny štítků' : 'Nová skupina štítků' }}
{% endblock %}

{% block content %}
    <div class="app-container container">
        <div class="{{ theme.card_class() }}">
            {{ form_macro.card_header(icons.back_to_list(path('admin:tag:list')) ~ block('title')) }}

            <div class="card-body">
                {{ block('edit_form') }}
            </div>
        </div>

        {% if editing %}
            <div class="{{ theme.card_class() }} mt-8">
                <div class="{{ theme.card_header_class() }}">
                    <div class="card-title">
                        <h3 class="mb-0">Štítky ve skupině <span class="text-muted fs-6 ms-2">{{ tags|length }}</span></h3>
                    </div>
                    <div class="card-toolbar gap-3">
                        <a href="{{ path('admin:tag:list', {'group_id': 0}) }}"
                           class="btn btn-sm btn-light-primary"
                           title="Vyberte štítky bez skupiny a použijte hromadnou akci „Přesunout do skupiny“">
                            <i class="bi bi-plus-lg"></i> Přidat existující
                        </a>
                        <a href="{{ path('admin:tag:edit', {'group_id': tag_group.id}) }}"
                           class="btn btn-sm btn-light-primary">
                            <i class="ki-outline ki-message-add fs-4"></i> Nový štítek
                        </a>
                        <a href="{{ path('admin:tag:list', {'group_id': tag_group.id}) }}"
                           class="btn btn-sm btn-light">
                            Zobrazit v seznamu
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% if tags|length > 0 %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for tag in tags %}
                                <span class="badge {{ tag.isPublic ? 'badge-light-primary' : 'badge-light' }} fs-6 py-2 px-3 d-inline-flex align-items-center">
                                    {% if tag.color %}
                                        <span class="d-inline-flex me-2">{{ tag_color.dot(tag) }}</span>
                                    {% endif %}
                                    <a href="{{ path('admin:tag:edit', {'id': tag.id}) }}"
                                       class="{{ tag.isPublic ? 'text-primary' : 'text-gray-700' }}">
                                        {{ tag.name }}
                                    </a>
                                    <a href="#"
                                       class="action-button ms-2 text-gray-500 text-hover-danger"
                                       title="Odebrat ze skupiny"
                                       data-method="tag/set-group"
                                       data-confirm=""
                                       data-parameters="{{ {'ids': [tag.id], 'parameters': {'group_id': null}}|json_encode }}">
                                        <i class="bi bi-x-lg fs-8"></i>
                                    </a>
                                </span>
                            {% endfor %}
                        </div>
                        <div class="text-muted fs-7 mt-4">
                            Nepublikované štítky jsou zobrazeny šedě.
                        </div>
                    {% else %}
                        {{ data_list.empty_set('Skupina zatím neobsahuje žádné štítky.') }}
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block edit_form %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_macro.section_header('Základní informace') }}
    <div class="row">
        <div class="col-12 col-md-6">
            {{ form_row(form.name) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.urlId) }}
        </div>
        <div class="col-12 col-md-2">
            {{ form_row(form.position) }}
        </div>
    </div>

    {{ form_macro.sticky_submit(form) }}

    {% if form._token is defined %}
        {{ form_row(form._token) }}
    {% endif %}

    {{ form_end(form, {render_rest: false}) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@CmsBundle/admin/partials/data-list-js.html.twig' %}
{% endblock %}
